VITE_MAPTILER_API_KEY=
# Optional in development. Set this to the public R2 latest.json URL in Netlify.
VITE_SNOW_MANIFEST_URL=
# Optional. A Geoapify API key for the A-to-B route planner (spec section 8).
# Free tier, no card. Restrict it to the deployed origin in the Geoapify console
# before it ships. Unset means the route planner reports itself unavailable -
# there is no fallback provider.
VITE_GEOAPIFY_API_KEY=
