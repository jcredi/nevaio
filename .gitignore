# dependencies
node_modules/
.venv/
pipeline/.venv/
__pycache__/

# build output
dist/
build/
.netlify/
*.tsbuildinfo

# local verification screenshots (npm run shot / npm run verify)
app/screenshots/
app/shots/

# environment / secrets - ignore every environment file by default (F8), then
# re-allow only the sanitized templates that are meant to be committed. A new
# .env.production / .env.r2 / .env.anything must not become committable just
# because nobody remembered to extend this list.
.env
.env.*
*.env
!.env.example
!.env.*.example

# Local data tree (see data/README.md). None of it is committed: research/ is
# the durable winter GFSC archive, cache/ is disposable downloads, output/ is
# generated artifacts. Only data/README.md itself is tracked.
data/*
!data/README.md

# downloaded satellite data - don't commit raw rasters
*.tif
*.tiff
*.jp2

# generated production/preview tile pyramids - published to R2, not Git
app/public/snow/latest.json
app/public/snow/runs/

# HR-WSI MGRS tile reference file (~16MB, easily re-fetched - see
# data/README.md). Research reference data, not a build input: production
# discovery hardcodes its tile list in pipeline/config.py precisely so it does
# not depend on this file.
*.gpkg

# personal Claude Code notes (not shared with the team)
CLAUDE.local.md
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/
