# dependencies
node_modules/
.venv/
pipeline/.venv/
__pycache__/

# build output
dist/
build/
.netlify/
*.tsbuildinfo

# local verification screenshots (npm run shot / npm run verify)
app/screenshots/
app/shots/

# environment / secrets - ignore every environment file by default (F8), then
# re-allow only the sanitized templates that are meant to be committed. A new
# .env.production / .env.r2 / .env.anything must not become committable just
# because nobody remembered to extend this list.
.env
.env.*
*.env
!.env.example
!.env.*.example

# Local pipeline scratch, if you point --raw-dir/--work-dir/--output-dir here
# rather than at /tmp. Never committed.
data/

# downloaded satellite data - don't commit raw rasters
*.tif
*.tiff
*.jp2

# generated production/preview tile pyramids - published to R2, not Git
app/public/snow/latest.json
app/public/snow/runs/

*.gpkg

# personal Claude Code notes (not shared with the team)
CLAUDE.local.md
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/
